{
  "name": "susweb",
  "private": true,
  "scripts": {
    "kotlin": "bun scripts/kotlin.ts",
    "build": "bun scripts/kotlin.ts build",
    "build:desktop": "bun scripts/kotlin.ts build -m desktopApp",
    "build:android": "bun scripts/kotlin.ts build -m androidApp",
    "dev": "bun scripts/kotlin.ts run -m desktopApp --compose-hot-reload",
    "start": "bun scripts/kotlin.ts run -m desktopApp",
    "test": "bun scripts/kotlin.ts test",
    "ktfmt": "bun scripts/ktfmt.ts",
    "ktfmt:check": "bun scripts/ktfmt.ts --dry-run --set-exit-if-changed shared androidApp desktopApp",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
